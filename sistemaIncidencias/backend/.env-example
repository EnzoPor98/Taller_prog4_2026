# Puerto del servidor (por defecto 3000)
PORT=3000

# ---------------------------------------------------------------
# Base de datos
# Si DATABASE_URL esta definida se usa esa conexion (Supabase, con SSL).
# Si no, se usa el PostgreSQL local con las variables DB_*.
# ---------------------------------------------------------------
# DATABASE_URL=postgresql://usuario:password@host:6543/postgres

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=incidencias_db

# Clave para firmar los tokens JWT
JWT_SECRET=

# Supabase Storage (archivos adjuntos de articulos)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=

# Envio de mails (SMTP, Nodemailer)
# Desarrollo: Mailpit (docker compose up -d) -> SMTP en localhost:1025, bandeja web en http://localhost:8025
# Mailpit no requiere usuario ni password (dejar SMTP_USER vacio).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=incidencias@localhost
