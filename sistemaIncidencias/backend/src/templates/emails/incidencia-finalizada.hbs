<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Incidencia finalizada</title>
</head>
<body style="margin:0;padding:0;background:#f1f5f9;font-family:Arial,sans-serif;color:#1e293b">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="padding:32px 12px">
        <tr>
            <td align="center">
                <table role="presentation" width="600" cellpadding="0" cellspacing="0"
                    style="max-width:600px;width:100%;background:#ffffff;border-radius:12px;overflow:hidden">

                    <!-- Encabezado -->
                    <tr>
                        <td style="background:#2C5C80;padding:28px;color:#ffffff">
                            <h1 style="margin:0;font-size:22px">Sistema de Incidencias</h1>
                            <p style="margin:8px 0 0;color:#cbd5e1">
                                Notificaciones del sistema
                            </p>
                        </td>
                    </tr>

                    <!-- Contenido -->
                    <tr>
                        <td style="padding:32px">
                            <p style="color:#16a34a;font-weight:bold">
                                INCIDENCIA FINALIZADA
                            </p>

                            <h2 style="margin-bottom:8px">
                                Hola, {{nombre}}
                            </h2>

                            <p style="line-height:1.6;color:#475569">
                                Te informamos que la incidencia registrada sobre el artículo
                                <strong>{{articulo}}</strong> ha sido finalizada.
                            </p>

                            <!-- Detalles de la incidencia -->
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                                style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px">
                                <tr>
                                    <td style="padding:20px">

                                        <p style="margin:0;color:#64748b;font-size:12px">
                                            NÚMERO DE INCIDENCIA
                                        </p>
                                        <h2 style="margin:8px 0 20px">
                                            #{{id}}
                                        </h2>

                                        <p style="margin:0;color:#64748b;font-size:12px">
                                            ARTÍCULO INVOLUCRADO
                                        </p>
                                        <p style="margin:8px 0 20px;font-weight:bold">
                                            {{articulo}}
                                        </p>

                                        <p style="margin:0;color:#64748b;font-size:12px">
                                            DESCRIPCIÓN DE LA RESOLUCIÓN
                                        </p>
                                        <p style="line-height:1.6;margin-bottom:20px">
                                            {{descripcion}}
                                        </p>

                                        <p style="margin:0;color:#64748b;font-size:12px">
                                            ÁREA RESPONSABLE
                                        </p>
                                        <p style="margin:8px 0 20px;font-weight:bold">
                                            {{area}}
                                        </p>

                                        <p style="margin:0;color:#64748b;font-size:12px">
                                            INCIDENCIA FINALIZADA POR
                                        </p>
                                        <p style="margin:8px 0 0;font-weight:bold">
                                            {{finalizadoPor}}
                                        </p>

                                    </td>
                                </tr>
                            </table>

                            <p style="line-height:1.6;color:#475569;margin-top:24px">
                                La incidencia ha sido marcada como finalizada por el área responsable.
                            </p>

                            <p style="margin-top:28px;color:#64748b;font-size:12px;line-height:1.5">
                                Este correo fue generado automáticamente por el sistema de incidencias.
                            </p>
                        </td>
                    </tr>

                    <!-- Pie -->
                    <tr>
                        <td style="background:#f8fafc;padding:18px;text-align:center;color:#64748b;font-size:12px">
                            Sistema de Incidencias · Notificación automática
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</body>
</html>
```